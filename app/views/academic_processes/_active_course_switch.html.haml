
- if (current_user&.admin&.authorized_manage? 'Course')
    - if tipo.eql? 0
        - id = @subj_id
        - disabled = @course&.sections&.any?
        - title = disabled ? 'Para habilitar esta opción elimine primero las secciones' : 'Activar o desactivar asignatura para este Porceso Académico'
        - name = "enabled_subject_#{@subj_id}"
        - checked = !@course.nil?
        - js_action_name = 'enableSubject(this);'

    - else 
        - id = @course.id
        - disabled = false
        - campo = tipo.eql?(1) ? 'offer' : 'offer_as_pci'
        -# Se guarda al cambiarlo, con el field-update de Stimulus (común con FAU).
        - data = {controller: 'field-update', 'field-update-url-value': main_app.course_path(@course), 'field-update-model-value': 'course', 'field-update-field-value': campo, action: 'change->field-update#patch'}
        - if tipo.eql? 1
            - title = 'Ofertar u ocultar asignatura durante la inscripción de los estudiantes' 
            - name = "course_offer_#{@course.id}"
            - checked = @course&.offer?
        - else
            - title = 'Ofertar u ocultar asignatura como PCI durante la inscripción de los estudiantes' 
            - name = "course_offer_as_pci_#{@course.id}"            
            - checked = @course&.offer_as_pci?
    = render partial: 'layouts/switch_checkbox_layout', locals: {title: title, name: name, id: id, checked: checked, disabled: disabled, js_action_name: js_action_name, data: data}
- else    
    - if @course
        %i.fas.fa-check
    - else
        %i.fas.fa-remove