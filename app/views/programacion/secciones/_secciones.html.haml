-# Las secciones de una asignatura en la Programación (FHE 23-nov, como en FAU). Van del tamaño de las insignias de
-# «Números» (components/_programacion_secciones.scss), con las acciones siempre al final de la celda:
-#
-#   [3] [V1 ×] [W1 ×] [X1 ×]     [🗑] [+]
-#    │    │   └ borra la sección; tenue si tiene inscritos   │    └ una sección nueva
-#    │    └ abre su panel para corregirla o duplicarla       └ borra todas, si hay más de una
-#    │      (el globo dice su horario y su profesor)
-#    └ el total: lleva a la lista de secciones del admin
-#
-# Con más de tres secciones, bajan a otro renglón y las acciones se quedan arriba, a la derecha. Al guardar o borrar,
-# Turbo Stream reemplaza este bloque entero, con la sección tocada resaltada y sin recargar. También lo devuelve
-# CoursesController#create al activar la asignatura. Las rutas van con main_app, porque este bloque también se dibuja
-# dentro de rails_admin. Los globos son los de Bootstrap (controlador «globo»), también en lo que llega por Turbo
-# Stream.
- admin = current_user&.admin
- resaltar ||= nil
- secciones = curso.sections.includes(:academic_records, :timeblocks, teacher: :user).sort_by { |s| Section.orden_del_codigo(s.code) }
.programacion-secciones{id: "secciones_curso_#{curso.id}"}
  .ps-lista
    - if admin&.authorized_read?('Section')
      - lista = "/admin/section?f[academic_process][39808][o]=like&f[academic_process][39808][v]=#{curso.academic_process.process_name}&f[school][40710][o]=like&f[school][40710][v]=#{curso.school.short_name}&f[subject][41128][o]=like&f[subject][41128][v]=#{curso.subject.code}&query="
      - if secciones.any?
        = link_to secciones.size, lista, class: 'ps-total', title: 'Total de secciones: abre la lista', data: {controller: 'globo'}
      - else
        %span.ps-total.ps-total--cero 0
    - if admin&.authorized_read?('Section') || admin&.authorized_update?('Section')
      - secciones.each do |sec|
        .ps-seccion{class: ('ps-seccion--resaltada' if sec.id == resaltar)}
          - globo = sec.schedule_teacher_desc_short
          - if admin.authorized_update?('Section')
            = link_to sec.code, main_app.programacion_editar_seccion_path(sec), class: 'ps-codigo', title: globo, data: {turbo_stream: true, controller: 'globo'}
          - else
            = link_to sec.code, "/admin/section/#{sec.id}", class: 'ps-codigo', title: globo, data: {controller: 'globo'}
          - if admin.authorized_delete?('Section')
            - if sec.academic_records.any?
              %span.ps-quitar.ps-inactivo{title: "La #{sec.code} tiene inscritos: elimine las inscripciones para poder borrarla", data: {controller: 'globo'}}
                %i.fas.fa-xmark
            - else
              = link_to main_app.programacion_seccion_path(sec), class: 'ps-quitar', title: "Eliminar la #{sec.code}", 'aria-label': "Eliminar la #{sec.code}", data: {controller: 'globo', turbo_method: :delete, turbo_confirm: "¿Eliminar la sección #{sec.code}? Esta acción es irreversible."} do
                %i.fas.fa-xmark
  .ps-acciones
    - if admin&.authorized_delete?('Section') && secciones.size > 1
      - if secciones.any? { |s| s.academic_records.any? }
        %span.ps-borrar-todas.ps-inactivo{title: 'Hay secciones con inscritos: elimine las inscripciones para poder borrarlas todas', data: {controller: 'globo'}}
          %i.fas.fa-trash
      - else
        = link_to main_app.programacion_secciones_path(course_id: curso.id), class: 'ps-borrar-todas', title: 'Eliminar todas las secciones', 'aria-label': 'Eliminar todas las secciones', data: {controller: 'globo', turbo_method: :delete, turbo_confirm: "¿Eliminar las #{secciones.size} secciones de la asignatura? Esta acción es irreversible."} do
          %i.fas.fa-trash
    - if admin&.authorized_create?('Section')
      = link_to main_app.programacion_nueva_seccion_path(course_id: curso.id), class: 'ps-agregar', title: 'Agregar una sección', 'aria-label': 'Agregar una sección', data: {turbo_stream: true, controller: 'globo'} do
        %i.fas.fa-plus
