%h3.text-center.my-2 Historial Académico

- enrolls = enroll_academic_processes.sort_by_period_reverse
- if approved
  - enrolls = enrolls.select { |enroll| enroll.academic_records.aprobado.any? }

- enrolls.each do |enroll_academic_process|
  -# Los números del período, los mismos de la pantalla: CE los reporta con el kardex (premio al mérito).
  -# No van en el de aprobadas: cuentan también las reprobadas, que esa lista no muestra.
  -# Sin notas todavía, un guion: el 0.0 del período en curso parecería real.
  - numeros = !approved
  - con_notas = enroll_academic_process.academic_records.qualified.any?
  - records = approved ? enroll_academic_process.academic_records.aprobado : enroll_academic_process.academic_records

  %table.table-sm.nobreak
    %thead
      %tr
        %th.text-center{style: 'width: 100px'} Período
        %th.text-center Estado Inscripción
        %th.text-center Estado de Permanencia
        %th.text-center Total inscripciones
        - if numeros
          %th.text-center Eficiencia
          %th.text-center Promedio Simple
          %th.text-center Promedio Ponderado

    %tbody
      %tr
        %td.text-center= enroll_academic_process.academic_process&.process_name
        %td.text-center
          .badge.bg-info= enroll_academic_process.enroll_status.titleize if enroll_academic_process.enroll_status
        %td.text-center
          .badge.bg-info= enroll_academic_process.permanence_status.titleize if enroll_academic_process.permanence_status
        %td.text-center= enroll_academic_process.academic_records.count
        - if numeros
          - %i[efficiency simple_average weighted_average].each do |numero|
            %td.text-center= con_notas ? enroll_academic_process.public_send(numero)&.round(2) : '—'

      %tr
        %td{style: 'padding: 10px', colspan: numeros ? 7 : 4}
          = render partial: 'academic_records/index_to_history_kardex', locals: {academic_records: records}
  %br