.border

	=# image_tag Rails.application.routes.url_helpers.rails_blob_path(virtual_object.backup_file, only_path: true), style: 'max-height: 500px;' #virtual_object.backup_file #'payment_3087'

	=# image_tag url_for(virtual_object.backup_file)
	=# image_tag main_app.url_for(object.profile_picture.thumb, only_path: true) if (object.profile_picture and object.profile_picture.attached? and object.profile_picture.content_type.eql? "image/jpeg")
	- if object.profile_picture&.attached? && object.profile_picture.representable?
		- begin
			- thumb = object.profile_picture_as_thumb
			= image_tag main_app.url_for(thumb, only_path: true), loading: 'lazy', onerror: "this.onerror=null;this.src='/assets/foto_perfil_default.png'" if thumb
		- rescue StandardError => e
	=# image_tag Rails.application.routes.url_helpers.rails_blob_path(object.profile_picture, only_path: true) #virtual_object.backup_file #'payment_3087'
	=# image_path virtual_object.backup_file
	=# image_path '/public/payment_receives/payment_3087' 
	=# virtual_object.backup_file.service_url
	=# image_tag object.profile_picture.variant(resize: '100x100').processed.service_url 
	=# url_for(virtual_object.backup_file)