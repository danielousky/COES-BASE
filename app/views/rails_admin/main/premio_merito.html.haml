-# Premio al Mérito Académico de la escuela. FHE es la matriz: ODON y FAU la copian cuando Daniel la aprueba.
-# El marco es común; el cuerpo depende de PREMIO_MERITO_POR_CARRERA: por el año (FHE, FAU) o por la carrera (ODON),
-# que cambia de lista sin ir al servidor y recuerda la elegida (`vista`) al cambiar de período.
- premio = School::PremioMerito.para(@object, params[:anio])
- anio = premio.anio
- enlace_de_periodo = ({ pestanas_target: 'enlace' } if premio.por_carrera?)

= turbo_frame_tag 'premio_merito', data: { turbo_action: 'advance', controller: ('pestanas' if premio.por_carrera?) } do
  %h5.text-primary.fw-bold.mb-3
    %i.fa-solid.fa-award.me-2
    = "Premio al Mérito Académico · #{@object.name}"

  - if anio.nil?
    .alert.alert-light.text-center.text-muted Esta escuela todavía no tiene años cursados.
  - else
    .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
      %ul.nav.nav-pills
        - premio.anios.each do |a|
          %li.nav-item
            = link_to rails_admin.premio_merito_path(model_name: 'school', id: @object.id, anio: a.numero, vista: params[:vista]), class: "nav-link #{'active' if a.numero == anio.numero}", data: enlace_de_periodo do
              = a.numero
              - if a.en_curso?
                %span.badge.rounded-pill.bg-warning.text-dark.ms-1 en curso
      = link_to rails_admin.premio_merito_path(model_name: 'school', id: @object.id, anio: anio.numero, formato: 'xlsx'), class: 'btn btn-outline-success btn-sm', data: { turbo: false } do
        %i.fa-solid.fa-file-excel.me-1
        = "Descargar Excel #{anio.numero}"

    = render "rails_admin/main/premio_merito_#{premio.por_carrera? ? 'carrera' : 'anio'}", premio: premio
